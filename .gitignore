# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Jupyter Notebook Artifacts ---
.ipynb_checkpoints/
*-checkpoint.ipynb
.virtual_documents/

# --- IDEs & Code Editors ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- OS-specific Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example

# --- Logs, Diagnostics & Temp Scripts ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
patch_*.py
diff_*.py
check_*.py
test_*.py
scratch/
tmp/

# --- Odoo Runtime Artifacts ---
*.dump
odoo.log
filestore/
sessions/

